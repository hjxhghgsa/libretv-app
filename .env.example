# LibreTV 桌面版 · 发布版默认配置（已脱敏，不含任何私密信息）
#
# 本文件由 build-app.sh 复制为打包目录的 resources/server/.env.local，随安装包分发。
# ① 首次使用请在安装目录里编辑该文件，把下面的 PASSWORD 改成你自己的（默认 change-me）。
# ② DEFAULT_SOURCES / DEFAULT_LIVE_SOURCES 是公开第三方影视采集 API 示例，非私密，可自行增删；
#    桌面版启动后也能在「设置 → 源站管理」里增删，无需改文件。

PASSWORD=change-me
COOKIE_SECURE=false
REQUEST_TIMEOUT=10000
SEARCH_SOURCE_TIMEOUT_MS=15000
SEARCH_MAX_PAGES=3
DEFAULT_RECOMMEND_SOURCE=hot-list

# ─────────────────────────────────────────────────────────────────────────
# 点播源：全部锁定到 /from/<线路名>/ 高画质线路
#
# 【为什么用 /from/<线路名>/ 而不是裸接口】
# LibreTV 的 cms-parser.ts 里 extractEpisodesFromPlayUrl() 取的是
# 「第一个含 m3u8 的播放组」，播放器也没有线路切换 UI。
# 而同一源的不同线路画质能差很多（2026-10-22 实测）：
#     飘零资源 wjm3u8 = 1280x720
#     飘零资源 ikm3u8 = 3840x2160   ← 同一个片子《我的三体第四季》
# 裸接口默认拿 wjm3u8，那条高画质线路永远用不上。
# Apple CMS 的 /from/<线路名>/ 能锁定线路，返回的 vod_play_from 就是它，
# 不改一行代码就能用上高画质。
#
# 【名称后缀 = 该线路的实测画质上限】
#   ★1080  三部测试片里稳定探出 1920x1080
#   720    该线路实测偏 720P，留着做兜底
# ⚠ 画质随片子变得厉害：同一个线路，《庆余年》是 1080P，
#    换成预告/解说就掉到 480P。用界面上的画质徽章现场确认。
# ─────────────────────────────────────────────────────────────────────────
DEFAULT_SOURCES=[{"name":"光速资源 ★1080","url":"https://api.guangsuapi.com/api.php/provide/vod/from/gsm3u8/"},{"name":"红牛资源 ★1080","url":"https://www.hongniuzy2.com/api.php/provide/vod/from/hnm3u8/"},{"name":"金鹰点播 ★1080","url":"https://jinyingzy.com/api.php/provide/vod/from/jinyingm3u8/"},{"name":"新浪资源 ★1080","url":"https://api.xinlangapi.com/xinlangapi.php/provide/vod/from/xlm3u8/"},{"name":"豪华资源 ★1080","url":"https://hhzyapi.com/api.php/provide/vod/from/hhm3u8/"},{"name":"极速资源 ★1080","url":"https://jszyapi.com/api.php/provide/vod/from/jsm3u8/"},{"name":"电影天堂 ★1080","url":"http://caiji.dyttzyapi.com/api.php/provide/vod/from/dyttm3u8/"},{"name":"飘零资源 ★1080","url":"https://p2100.net/api.php/provide/vod/from/ikm3u8/"},{"name":"魔都资源 ★1080","url":"https://www.mdzyapi.com/api.php/provide/vod/from/modum3u8/"},{"name":"魔都动漫 ★1080","url":"https://caiji.moduapi.cc/api.php/provide/vod/from/modum3u8/"},{"name":"最大资源 ★1080","url":"https://api.zuidapi.com/api.php/provide/vod/from/zuidam3u8/"},{"name":"非凡资源 ★1080","url":"https://api.ffzyapi.com/api.php/provide/vod/from/ffm3u8/"},{"name":"非凡影视 ★1080","url":"https://cj.ffzyapi.com/api.php/provide/vod/from/ffm3u8/"},{"name":"量子影视 ★1080","url":"https://cj.lziapi.com/api.php/provide/vod/from/lzm3u8/"},{"name":"百度资源 720","url":"https://api.apibdzy.com/api.php/provide/vod/from/dbm3u8/"},{"name":"U酷影视 720·番剧","url":"https://api.ukuapi88.com/api.php/provide/vod/from/ukm3u8/"},{"name":"飘零资源 720","url":"https://p2100.net/api.php/provide/vod/from/wjm3u8/"},{"name":"无尽资源 720","url":"https://api.wujinapi.com/api.php/provide/vod"}]

DEFAULT_LIVE_SOURCES=[{"name":"央视+卫视（IPTV-Org 中国）","url":"https://iptv-org.github.io/iptv/countries/cn.m3u"},{"name":"全球直播（IPTV-Org）","url":"https://iptv-org.github.io/iptv/index.m3u"}]